<Window x:Class="Pinboard.Clock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinboard Clock"
        Width="320" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border CornerRadius="26"
            Background="#C7181A1F"
            BorderBrush="#2EFFFFFF" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TimeText"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontWeight="Light" FontSize="68"
                       Foreground="White" HorizontalAlignment="Center" />
            <TextBlock x:Name="DateText"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="16"
                       Foreground="#B8FFFFFF" HorizontalAlignment="Center" Margin="0,-4,0,0" />
        </StackPanel>
    </Border>
</Window>
