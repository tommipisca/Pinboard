<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Pinboard.ico</ApplicationIcon>
    <RootNamespace>Pinboard</RootNamespace>
    <AssemblyName>Pinboard</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.2.0</Version>
    <Product>Pinboard</Product>
    <Description>Widgets for the Windows desktop</Description>
    <Authors>Tommaso Piscaglia</Authors>
    <!-- Main is in Program.cs: Velopack must run before WPF. -->
    <StartupObject>Pinboard.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF and WinForms together create ambiguous names (Application, Color...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/Pinboard.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
